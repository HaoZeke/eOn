[wrap-git]
directory = rgpot
url = https://github.com/OmniPotentRPC/rgpot.git
# Pot-hosting infra, batch-1 kernels (Morse, LJCluster, ZBL), and the
# Fortran 2018 kernels (SW, EDIP, Lenosky, Tersoff, EAM-Al, FeHe, CuH2,
# TIP4P-H). v3.0.0 is the first release carrying them; the major is for the
# packaging change (no libptlrpc.so, librgpot.so.3).
#
# The force-batch implementation is present in this immutable upstream merge.
# Keeping the full revision makes packaged and source builds resolve the same
# C++ interface instead of following a moving compatibility branch.
revision = 7c2752343731818c7ac5b2d386e38c68304b5062
depth = 1

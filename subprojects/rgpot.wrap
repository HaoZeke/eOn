[wrap-git]
directory = rgpot
url = https://github.com/HaoZeke/potlib.git
# Pot-hosting infra, batch-1 kernels (Morse, LJCluster, ZBL), and the
# Fortran 2018 kernels (SW, EDIP, Lenosky, Tersoff, EAM-Al, FeHe, CuH2,
# TIP4P-H). v3.0.0 is the first release carrying them; the major is for the
# packaging change (no libptlrpc.so, librgpot.so.3).
#
# Tracking a branch rather than the v3.0.0 tag: RgpotAdapter::forceBatch
# needs rgpot::ForceBatch and Potential::forceBatchImpl, and backend=uma
# needs the generic engine ABI + UmaParams schema arm; feat/uma-engine-abi
# descends from feat/force-batch-impl and carries both. Pin back to the
# tag that ships them once one exists.
revision = feat/uma-engine-abi
depth = 1
